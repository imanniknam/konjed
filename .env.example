# --- required in production ---
DATABASE_URL=postgres://user:pass@host:5432/konjed
SITE_URL=https://konjed.example        # used for cookies (Secure), sitemap, Open Graph
# --- optional ---
SESSION_COOKIE=konjed_session
ANTHROPIC_API_KEY=                     # enables Claude-based mission evaluation (heuristic fallback otherwise)
EVAL_MODEL=claude-haiku-4-5-20251001
UPLOAD_DIR=.data/uploads               # mount a persistent volume in production (or swap storage for S3)
ADMIN_EMAIL=                           # created/ensured at seed time
ADMIN_PASSWORD=
